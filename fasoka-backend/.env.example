# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/fasoka
PGHOST=localhost
PGPORT=5432
PGDATABASE=fasoka
PGUSER=postgres
PGPASSWORD=changeme

# Serveur
PORT=4000
NODE_ENV=development

# Sécurité
# Obligatoire : 32 caractères minimum, le serveur refuse de démarrer sinon.
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Mettre 0 si le serveur est exposé directement, sans proxy (Railway, Render, nginx... : laisser vide)
TRUST_PROXY=
# true = en développement, affiche les emails (donc les codes) dans les logs quand aucun fournisseur n'est configuré
EMAIL_SIMULATION=

# Mobile Money (à remplir une fois le partenariat obtenu)
MIXX_API_KEY=
MIXX_API_SECRET=
MIXX_BASE_URL=
FLOOZ_API_KEY=
FLOOZ_API_SECRET=
FLOOZ_BASE_URL=

# Mode simulation paiement (true tant que les vraies clés API ne sont pas actives)
PAYMENT_SIMULATION_MODE=true

# Stockage des images (Cloudinary - compte gratuit sur cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
